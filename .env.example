# This file contains example environment variables for both development and production.
# Copy this file to `.env` and replace the placeholder values with real credentials.

# Development environment
DEV_API_BASE_URL=https://your-dev-api-url
DEV_WEB_BASE_URL=https://your-dev-web-url
DEV_PARTNER_USERNAME=your_dev_partner_username
DEV_PARTNER_PASSWORD=your_dev_partner_password
DEV_MERCHANT_USERNAME=your_dev_merchant_username
DEV_MERCHANT_PASSWORD=your_dev_merchant_password
DEV_DUP_USERNAME=existing_dev_username_for_negative_test
DEV_MEXCHANGE_API_URL=https://your-dev-mexchange-api-url
DEV_MEXCHANGE_WEB_URL=https://your-dev-mexchange-web-url
DEV_MEXCHANGE_USERNAME=your_dev_mexchange_username
DEV_MEXCHANGE_PASSWORD=your_dev_mexchange_password
DEV_AAP_BASE_URL=https://your-dev-aap-url
DEV_AAP_USERNAME=your_dev_aap_username
DEV_AAP_PASSWORD=your_dev_aap_password

# Production environment
PROD_API_BASE_URL=https://your-prod-api-url
PROD_WEB_BASE_URL=https://your-prod-web-url
PROD_PARTNER_USERNAME=your_prod_partner_username
PROD_PARTNER_PASSWORD=your_prod_partner_password
PROD_MERCHANT_USERNAME=your_prod_merchant_username
PROD_MERCHANT_PASSWORD=your_prod_merchant_password
PROD_DUP_USERNAME=existing_prod_username_for_negative_test
PROD_MEXCHANGE_API_URL=https://your-prod-mexchange-api-url
PROD_MEXCHANGE_WEB_URL=https://your-prod-mexchange-web-url
PROD_MEXCHANGE_USERNAME=your_prod_mexchange_username
PROD_MEXCHANGE_PASSWORD=your_prod_mexchange_password
PROD_AAP_BASE_URL=https://your-prod-aap-url
PROD_AAP_USERNAME=your_prod_aap_username
PROD_AAP_PASSWORD=your_prod_aap_password